# ── 회원가입·로그인 API 환경변수 예시 ──
# 실제 값은 .env 파일에 넣으며, .env 는 .gitignore 로 커밋되지 않습니다.

# JWT 서명 시크릿 (필수). 설정하지 않으면 애플리케이션 기동이 실패합니다.
JWT_SECRET=여기에-충분히-긴-랜덤-시크릿을-넣으세요

# JWT 서명 알고리즘 (기본값 HS256)
JWT_ALGORITHM=HS256

# 액세스 토큰 만료 시간(분). 기본 60분.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 데이터베이스 URL. 기본은 로컬 SQLite 파일(app.db, gitignore 대상).
DATABASE_URL=sqlite:///./app.db
