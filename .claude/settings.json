{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-usage-stats.sh\"",
            "timeout": 10,
            "statusMessage": "스킬 호출 통계 기록 중..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-open-requests.sh\"",
            "timeout": 5,
            "statusMessage": "유지보수 요청 현황 확인 중..."
          }
        ]
      }
    ]
  }
}
