{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.skill // \"unknown\"' | { read -r s; printf '%s\\t%s\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" \"$s\" >> \"$CLAUDE_PROJECT_DIR/.claude/skill-usage.log\"; } 2>/dev/null || true",
            "statusMessage": "스킬 호출 기록 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-pr-template.sh\"",
            "statusMessage": "PR 템플릿 강제 검사..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-context.sh\"",
            "statusMessage": "컨텍스트 카드 주입 확인..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-domain.sh\"",
            "statusMessage": "도메인 문서 주입 확인..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.prompt // \"\"' | grep -oE '^/[a-zA-Z][a-zA-Z0-9:_-]*' | head -1 | sed 's|^/||' | { read -r s; [ -n \"$s\" ] && printf '%s\\t%s\\n' \"$(date '+%Y-%m-%d %H:%M:%S')\" \"$s\" >> \"$CLAUDE_PROJECT_DIR/.claude/skill-usage.log\"; } 2>/dev/null || true",
            "statusMessage": "슬래시 명령 기록 중..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/retro-reminder.sh\"",
            "statusMessage": "회고 리마인더..."
          }
        ]
      }
    ]
  }
}
