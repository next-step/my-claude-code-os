{
  "permissions": {
    "allow": [
      "mcp__confluence__confluence_get_page",
      "mcp__confluence__confluence_get_page_children",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git cherry-pick *)",
      "Bash(.venv/bin/python eval/run.py *)",
      "Bash(.venv/bin/python eval/score.py *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record_skill_usage.py\""
          }
        ]
      }
    ]
  }
}
