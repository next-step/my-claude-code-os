#!/usr/bin/env python3
"""phplint - syntax-check a legacy file against the runtime it actually ships on.

    phplint <file>...        lint each file with its own service's PHP version
    phplint --as <path> -    lint stdin, using <path> to pick the version

Which service runs which PHP version, and the container image that version is
checked in, come from `legacy.runtimes` in workspace.json. A prefix with no entry
there is reported as **not checked** — never as passing. The local `php` binary
is not used at all: it accepts syntax an older runtime rejects, so it proves
nothing about the runtime the file actually ships on. Files go to the container
on stdin, so no mount is needed and the file's encoding is irrelevant — PHP
lexes bytes.

An older runtime rejects the newer grammar (short arrays, traits, finally,
variadics, ??, return types, match) but it cannot reject functions that merely
did not exist yet, because a call to an undefined function is a runtime error.
Those are checked by name below instead.

Containers run with short_open_tag on. Turn that off and a file opening with
`<?` reads as plain HTML and comes back clean whatever is inside it.
"""
import os
import re
import subprocess
import sys
import time
import uuid

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _phpenc import require_config, runtime_for_prefix, service_of  # noqa: E402

# Image references live in `legacy.runtimes[<prefix>]` of workspace.json. An image whose tag can
# move is pinned there by digest, and how to obtain it when absent is recorded alongside as
# `howto` - a missing image is not a syntax failure but "could not check", and handing that
# distinction to the user requires having the way to obtain it at hand.
LINT_EXT = (".php", ".inc", ".tpl", ".phtml")

# The total seconds available to docker. A caller has to be able to fit this tool inside its own
# budget: `php-encoding-guard.py` calls it with 25s inside a 35s hook, so if docker inside that
# were 60s **the outer one dies first and the result disappears as nothing at all rather than as
# "could not check".** So the budget comes from an env var. The default when called directly
# remains 60s.
DOCKER_BUDGET_ENV = "PHPLINT_DOCKER_TIMEOUT"
DOCKER_BUDGET_DEFAULT = 60


def docker_budget():
    try:
        v = float(os.environ.get(DOCKER_BUDGET_ENV, "") or DOCKER_BUDGET_DEFAULT)
    except ValueError:
        return DOCKER_BUDGET_DEFAULT
    return max(3.0, v)

# Third-party code vendored into the tree. Not ours to fix, so a file list skips
# it - but `--as` still checks whatever the caller explicitly named.
VENDORED = ("/vendor/", "/node_modules/", "/external/", "/phpexcel/",
            "/codeigniter", "/namo", "/adminlte", "/ckeditor/", "/sheetjs/")

# Functions the 5.3 parser accepts happily because a call to an undefined
# function is a runtime error, not a syntax error. Version each one was added.
LATER_FUNCTIONS = {
    "hex2bin": "5.4", "http_response_code": "5.4",
    "array_column": "5.5", "password_hash": "5.5", "password_verify": "5.5",
    "boolval": "5.5", "json_last_error_msg": "5.5",
    "ldap_escape": "5.6",
    "intdiv": "7.0", "random_int": "7.0", "random_bytes": "7.0",
    "is_iterable": "7.1", "spl_object_id": "7.2",
    "array_key_first": "7.3", "array_key_last": "7.3", "is_countable": "7.3",
    "str_contains": "8.0", "str_starts_with": "8.0", "str_ends_with": "8.0",
    "fdiv": "8.0", "get_debug_type": "8.0",
    "array_is_list": "8.1", "enum_exists": "8.1",
    "json_validate": "8.3",
}


def runtime_for(path):
    """The PHP version this path ships on, or None when config does not say.

    `legacy.runtimes` gives the answer. A shared tree loaded by both runtimes is recorded in the
    config as the lower one - code that parses on the lower version parses on the higher one, but
    not the reverse. A prefix absent from the config is None, and the caller reports that as
    "could not check", never as "passed".
    """
    svc = service_of(path)
    if not svc:
        return None
    rt = runtime_for_prefix(svc[0])
    return (rt or {}).get("php")


def image_for(version):
    """(image, howto) for a PHP version, or (None, None)."""
    for rt in (require_config("phplint").get("runtimes") or {}).values():
        if rt.get("php") == version:
            return rt.get("image"), rt.get("howto", "")
    return None, None


def parse_check(data, version):
    """Run php -l in the container. Returns (ok, message).

    Retried once: the 5.3 image is amd64 and segfaults under emulation now and
    then, which would otherwise surface as "could not check". **The retry is
    deadline-aware**: a segfault fails in under a second and leaves the budget
    almost intact, while a hang consumes it — and retrying after a hang is how
    a 60-second budget became 120 seconds inside a caller that allowed 25.
    """
    budget = docker_budget()
    t0 = time.time()
    ok, msg = _parse_once(data, version, budget)
    left = budget - (time.time() - t0)
    if ok is None and left > 2:
        ok, msg = _parse_once(data, version, left)
    return ok, msg


def _parse_once(data, version, budget=None):
    image, howto = image_for(version)
    if not image:
        return None, (f"workspace.json has no image in legacy.runtimes to check "
                      f"PHP {version} with")
    # Name the container so a timeout can still reach it. `subprocess.run`'s
    # timeout kills the docker *client*, not the container it started, and
    # `--rm` only fires when the container itself stops - so an emulated 5.3
    # run that hangs on stdin leaks a running container for every call. Four of
    # them were found alive six hours after the fact.
    name = f"phplint-{os.getpid()}-{uuid.uuid4().hex[:8]}"
    try:
        p = subprocess.run(
            ["docker", "run", "--rm", "-i", "--name", name,
             "--platform", "linux/amd64",
             "--entrypoint", "php", image,
             # both deployed php.ini files set this On, and 496 files in the
             # tree open with `<?`. Without it the 8.3 image reads such a file
             # as plain HTML and reports it clean whatever is inside.
             "-d", "short_open_tag=1", "-l"],
            input=data, capture_output=True,
            timeout=budget if budget is not None else docker_budget())
    except FileNotFoundError:
        return None, "docker not found - cannot check syntax"
    except subprocess.TimeoutExpired:
        # `stop`, not `rm -f`: the container was started with --rm, so stopping
        # it is enough to have it removed, and it leaves a force-delete out of
        # a tool that runs unattended.
        # Keep `stop`'s own cap short. This cleanup has to fit inside the caller's budget too,
        # and `-t 0` is one question to the daemon.
        try:
            subprocess.run(["docker", "stop", "-t", "0", name],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass          # even if cleanup fails, the answer is the single "could not check"
        return None, (f"docker timed out running {image} "
                      f"({int(budget if budget is not None else docker_budget())}s)")
    out = (p.stdout + p.stderr).decode("utf-8", "replace")
    if "Unable to find image" in out or "no such image" in out.lower():
        return None, f"PHP {version} image is missing - {howto}"
    if p.returncode == 0:
        return True, ""
    lines = [ln.strip() for ln in out.splitlines()
             if "parse error" in ln.lower() or "fatal error" in ln.lower()]
    if not lines:
        # docker failed for its own reasons. Do not report that as bad syntax -
        # a gate that blocks on an unclear result is worse than no gate.
        return None, f"{image} exited {p.returncode} without a parse error: " \
                     f"{out.strip()[:200]}"
    return False, "\n".join(lines)


def function_check(data, version):
    """Names that parse fine but do not exist on the target runtime."""
    if version != "5.3":
        return []
    text = data.decode("utf-8", "replace")
    found = []
    for name, since in sorted(LATER_FUNCTIONS.items()):
        # a call, not a substring ($boolvalue), not a method ($o->boolval()),
        # not a polyfill definition (function array_column(...))
        if re.search(r"(?<![\w$>])(?<!function )" + name + r"\s*\(", text, re.I):
            found.append(f"{name}() needs PHP {since}")
    return found


def lint(data, path, version):
    ok, msg = parse_check(data, version)
    if ok is None:
        print(f"phplint: {msg}", file=sys.stderr)
        return 2
    problems = [] if ok else [msg]
    problems += function_check(data, version)
    if not problems:
        print(f"phplint: {path} OK on PHP {version}", file=sys.stderr)
        return 0
    print(f"phplint: {path} FAILS on PHP {version} "
          f"(the runtime this file ships on)", file=sys.stderr)
    for p in problems:
        print(f"  {p}", file=sys.stderr)
    return 1


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 2

    if argv[0] == "--as":
        if len(argv) < 2:
            print("phplint: --as needs a path", file=sys.stderr)
            return 2
        path = argv[1]
        version = runtime_for(path)
        if not version:
            print(f"phplint: {path} is outside our services - not checked",
                  file=sys.stderr)
            return 0
        return lint(sys.stdin.buffer.read(), path, version)

    worst = 0
    unchecked = 0
    for path in argv:
        if not path.lower().endswith(LINT_EXT):
            print(f"phplint: {path} is not PHP - skipped", file=sys.stderr)
            continue
        low = "/" + os.path.abspath(path).lower().lstrip("/")
        if any(v in low for v in VENDORED):
            print(f"phplint: {path} is a vendored bundle - skipped",
                  file=sys.stderr)
            continue
        if not os.path.isfile(path):
            print(f"phplint: not a file: {path}", file=sys.stderr)
            worst = max(worst, 2)
            continue
        version = runtime_for(path)
        if not version:
            print(f"phplint: {path} is outside our services - not checked",
                  file=sys.stderr)
            unchecked += 1
            continue
        with open(path, "rb") as fh:
            worst = max(worst, lint(fh.read(), path, version))
    # It never returns 0 for something it could not check. To a caller 0 reads as "this file
    # parses on the production runtime", and that is the very failure this tool exists to prevent.
    # It does not block - 3 means "did not answer", not a failure, and it is enough that the
    # caller can tell it from a pass.
    if worst == 0 and unchecked:
        return 3
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
