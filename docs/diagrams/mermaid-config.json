{
  "theme": "base",
  "htmlLabels": false,
  "themeVariables": {
    "fontFamily": "Apple SD Gothic Neo, Noto Sans KR, Malgun Gothic, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#111827",
    "primaryBorderColor": "#4b5563",
    "lineColor": "#4b5563",
    "textColor": "#111827"
  },
  "flowchart": {
    "htmlLabels": false,
    "nodeSpacing": 55,
    "rankSpacing": 65,
